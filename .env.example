# Copy to .env.local (git-ignored) and fill in.

# Required for Ask Hallinta. Create one at https://platform.claude.com/settings/keys
ANTHROPIC_API_KEY=

# Model for Hallinta. Defaults to claude-haiku-4-5 (cheapest).
# HALLINTA_MODEL=claude-sonnet-5

# Model for drafting project updates (defaults to HALLINTA_MODEL). Sonnet 5 makes
# noticeably more faithful edits than Haiku for ~2-3 cents per update.
# HALLINTA_UPDATE_MODEL=claude-sonnet-5

# Where project folders live. Defaults to ./data
# HALLINTA_DATA_DIR=/path/to/research/projects

# Team mode: secret used to sign session cookies (at least 32 characters).
# If unset, Hallinta generates one in <data>/.hallinta/secret.
# HALLINTA_SESSION_SECRET=

# Team mode, optional: Google sign-in (invite-only). See docs/google-sign-in.md.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# Public address of this Hallinta, if it differs from what the server sees (reverse proxy):
# HALLINTA_PUBLIC_URL=https://hallinta.your-lab.example
